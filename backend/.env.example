# Local development values only. Copy to .env and keep it untracked.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://chosen_one_dev:chosen_one_dev_password@localhost:5432/chosen_one

# --- Google Workspace sign-in (Milestone 2) -------------------------------------------------
# Create these in the BIG Google Cloud project (OAuth client, type "Web application", Internal).
# The redirect URI must be registered with Google EXACTLY as written here. Either of these works
# locally (the session cookie is shared across ports on localhost):
#   http://localhost:8000/auth/google/callback          (straight to FastAPI)
#   http://localhost:5173/api/auth/google/callback      (through the Vite proxy)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Optional extra restriction to one Workspace domain. Never grants access by itself: a person must
# also be provisioned (python -m app.provisioning grant ...).
GOOGLE_HOSTED_DOMAIN=

# Signs the session cookie. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (32+ characters) when APP_ENV is staging or production; in development, leaving it empty
# uses a random per-process secret, so sessions end whenever the API restarts.
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=28800

# --- HubSpot pipeline (Milestone 3) ---------------------------------------------------------
# Where deals come from. "workbook" reads the supplied HubSpot export; "api" is reserved for the
# future live adapter, which will be strictly read-only (it is not implemented yet).
HUBSPOT_SOURCE=workbook
# Optional path to the export. Empty uses reference/03-demo-data/HubSpot_OnDeck_Dummy_2026-10-01.xlsx
# relative to the repository (not available inside the Docker images; mount or point elsewhere).
HUBSPOT_WORKBOOK_PATH=
# Read-only private-app token for the future live adapter. Unused today; never commit a real one.
HUBSPOT_ACCESS_TOKEN=
# PRD: a Closed Won draft unconfirmed after this many business days alerts the owner and CRO.
DRAFT_CONFIRMATION_BUSINESS_DAYS=2
# PRD: sync at least hourly; the UI shows a "sync stale since" banner once the last good sync is older.
HUBSPOT_STALE_AFTER_MINUTES=60

# --- QA engine and AI Revenue Detective (Milestone 5) ---------------------------------------
# Claude is called ONLY when ANTHROPIC_API_KEY is set (an approved enterprise key) AND
# AI_DATA_USE_APPROVED=true (confirms the enterprise data-use terms cover sending forecast data).
# With either missing, the deterministic investigator answers and the UI says why. Never commit a key.
ANTHROPIC_API_KEY=
AI_DATA_USE_APPROVED=false
ANTHROPIC_MODEL=claude-sonnet-5-5
# Cost ceiling: at most this many Claude investigations per calendar month; then deterministic.
AI_MONTHLY_CALL_LIMIT=200
AI_TIMEOUT_SECONDS=60
# PRD thresholds for the deterministic checks (defaults shown).
QA_STALE_DAYS=30
QA_MISMATCH_PERCENT=10
QA_ANOMALY_MIN_AMOUNT=5000
QA_ANOMALY_MIN_PERCENT=30
FRONTEND_URL=http://localhost:5173
