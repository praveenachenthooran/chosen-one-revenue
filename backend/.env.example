# Local development values only. Copy to .env and keep it untracked.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://chosen_one_dev:chosen_one_dev_password@localhost:5432/chosen_one

# --- Google Workspace sign-in (Milestone 2) -------------------------------------------------
# Create these in the BIG Google Cloud project (OAuth client, type "Web application", Internal).
# The redirect URI must be registered with Google EXACTLY as written here. Either of these works
# locally (the session cookie is shared across ports on localhost):
#   http://localhost:8000/auth/google/callback          (straight to FastAPI)
#   http://localhost:5173/api/auth/google/callback      (through the Vite proxy)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Optional extra restriction to one Workspace domain. Never grants access by itself: a person must
# also be provisioned (python -m app.provisioning grant ...).
GOOGLE_HOSTED_DOMAIN=

# Signs the session cookie. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (32+ characters) when APP_ENV is staging or production; in development, leaving it empty
# uses a random per-process secret, so sessions end whenever the API restarts.
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=28800

ANTHROPIC_API_KEY=
FRONTEND_URL=http://localhost:5173
